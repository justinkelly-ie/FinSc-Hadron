package FinSc-Nuclear-Matter
version = 0.3.1
authors = "Justin Kelly"
brief   = "Layer 5b Hadronic Confinement, Quark Trapping & Stellar Nucleosynthesis Engine."

depends = FinSc-Geometry, FinSc-Multiset, FinSc-Metric-Substrate, FinSc-Phase-Unfolding, base, linear
sourcedir = "src"

modules = NuclearMatter,
          Hadron,
          Stage0.Hadron.AlphaReplication,
          Stage0.Hadron.CosmicNucleosynthesis,
          Stage0.Hadron.HadronizationEngine,
          Stage0.Hadron.HadronScaleTransforms,
          Stage0.Hadron.NucleosynthesisStream,
          Stage0.Hadron.ParticleScattering,
          Stage0.Hadron.PlasmaRecombination,
          Stage0.Hadron.StellarNucleosynthesis,
          Stage1.Hadron.ExoticMultiquark,
          Stage1.Hadron.GaugeBosons,
          Stage1.Hadron.HadronicConfinement,
          Stage1.Hadron.HeavyMesonAlgebra,
          Stage1.Hadron.HyperonAlgebra,
          Stage1.Hadron.MesonAlgebra,
          Stage1.Hadron.MuonG2Anomaly,
          Stage1.Hadron.QuarkHadronAlgebra,
          Stage1.Hadron.StandardModel,
          Stage1.Hadron.StellarNuclei,
          Stage1.Hadron.TypeIndexedMultiset
